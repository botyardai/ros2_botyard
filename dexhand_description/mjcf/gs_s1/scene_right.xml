<mujoco model="right_botyard_dexhand scene">
  <include file="dexhand_right.xml"/>

  <!-- 覆盖 dexhand_right.xml 的调试设定：恢复重力与接触，场景才有物理意义 -->
  <option timestep="0.001" gravity="0 0 -9.81">
    <flag contact="enable"/>
  </option>

  <statistic extent="0.3" center="0 0.03 0.25"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="8192"/>
    <global azimuth="220" elevation="-30"/>
    <scale framewidth="0.03" framelength="1.0"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.4 0.4 0.4" specular="0.5 0.5 0.5" active="1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- 场景物体：位置沿用远端 scene_right.xml -->
    <body name="object" pos="-0.3 0.01 0.1">
      <freejoint/>
      <geom type="ellipsoid" size="0.03 0.04 0.02" rgba="0.5 0.7 0.5 1" condim="6" priority="1"
        friction="0.5 0.01 0.003"/>
    </body>
  </worldbody>
  <!-- 默认姿态下相邻部件互相嵌入；不排除的话接触力会把仿真打飞（远端 left/right_dexhand.xml 同样处理） -->
  <contact>
    <exclude body1="world" body2="falink1"/>
    <exclude body1="world" body2="pmbase"/>
    <exclude body1="pmbase" body2="thproximal"/>
    <exclude body1="pmbase" body2="ffproximal"/>
    <exclude body1="pmbase" body2="mfproximal"/>
    <exclude body1="pmbase" body2="rfproximal"/>
    <exclude body1="pmbase" body2="lfproximal"/>
  </contact>
</mujoco>
