<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="forearm">
<!-- construct pure URDF start -->
    <!-- forearm -->
    <xacro:include filename="$(find dexhand_description)/urdf/forearm_macro.xacro"/>

    <!-- create link fixed to the "world" -->
    <link name="world"/>
    <xacro:forearm_macro prefix="" parent_link="world" joint_type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:forearm_macro>
<!-- construct pure URDF end -->

    <!-- Import Rviz colors -->
    <xacro:include filename="$(find dexhand_description)/urdf/inc/common.materials.xacro"/>

</robot>
