<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur_with_dexhand">

    <!-- possible 'ur_type' values: ur3, ur3e, ur5, ur5e, ur7e, ur10, ur10e, ur12e, ur16e, ur20, ur30 -->
    <!-- the default value should raise an error in case this was called without defining the type -->
    <xacro:arg name="ur_type" default="ur16e" />
    <!-- Define tf_prefix parameter -->
    <xacro:arg name="tf_prefix" default=""/>
    <xacro:arg name="joint_limit_params" default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml" />
    <xacro:arg name="kinematics_params" default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml" />
    <xacro:arg name="physical_params" default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml" />
    <xacro:arg name="visual_params" default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml" />
    <!--When using gazebo simulations absolute paths are necessary.-->
    <xacro:arg name="force_abs_paths" default="false" />

    <xacro:arg name="use_ros2_control" default="false"/>
    <xacro:arg name="use_gazebo" default="false"/>
    <xacro:arg name="use_mock_dexhand" default="true" />
    <xacro:arg name="use_fake_hardware" default="false"/>
    <xacro:arg name="use_left_hand" default="true" />

    <!-- 固定UR机械臂的试验台 -->
    <link name="world" >
        <visual>
            <origin xyz="0 0 0.3" rpy="0 0 0" />
            <geometry>
                <box size="2 2 0.6" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.3" rpy="0 0 0" />
            <geometry>
                <box size="2 2 0.6" />
            </geometry>
        </collision>
    </link>
    <!-- ur_robot -->
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
    <xacro:ur_robot 
        name="ur_manipulator"
        parent="world"
        tf_prefix="$(arg tf_prefix)" 
        joint_limits_parameters_file="$(arg joint_limit_params)"
        kinematics_parameters_file="$(arg kinematics_params)"
        physical_parameters_file="$(arg physical_params)"
        visual_parameters_file="$(arg visual_params)"
        safety_limits="true"
        safety_pos_margin="0.15"
        safety_k_position="20"
        force_abs_paths="$(arg force_abs_paths)" >
        <!-- position of the robot arm, adjust as needed -->
        <origin xyz="0 0 0.6" rpy="0 0 0" />
    </xacro:ur_robot>
    <xacro:if value="$(arg use_fake_hardware)">
        <xacro:include filename="$(find ur_description)/urdf/ros2_control_mock_hardware.xacro"/>
        <xacro:ur_ros2_control name="ur_system" tf_prefix="$(arg tf_prefix)" />
    </xacro:if>
    <!-- dexhand -->
    <xacro:include filename="$(find dexhand_description)/urdf/dexhand_single_macro.xacro" />
    <xacro:dexhand_single_macro use_left_hand="$(arg use_left_hand)"
                                use_ros2_control="$(arg use_ros2_control)"
                                use_gazebo="$(arg use_gazebo)"
                                use_mock_dexhand="$(arg use_mock_dexhand)"
                                prefix="$(arg tf_prefix)"
                                parent_link="tool0"
                                joint_type="fixed">
        <origin xyz="0 0 0" rpy="0 0 3.14159" />
    </xacro:dexhand_single_macro>

    <!-- add a collision shell for dexhand -->
    <link name="$(arg tf_prefix)forearm_shell">
      <visual>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <geometry>
          <!-- 前臂直径为10cm，高度为30cm的圆柱体 -->
          <cylinder radius="0.05" length="0.30"/>
        </geometry>
        <material name="">
            <color rgba="1 1 1 0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.15" rpy="0 0 0"/>
        <geometry>
          <!-- 直径为10cm，高度为30cm的圆柱体 -->
          <cylinder radius="0.05" length="0.30"/>
        </geometry>
      </collision>
    </link>
    <joint name="$(arg tf_prefix)tool0-forearm_shell" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="$(arg tf_prefix)tool0"/>
      <child link="$(arg tf_prefix)forearm_shell"/>
    </joint>

    <link name="$(arg tf_prefix)hand_shell">
        <visual>
            <origin xyz="0 0 0.08" rpy="0 0 0" />
            <!-- 手掌为 宽10cm * 厚2cm * 长16cm 的盒子 -->
            <geometry>
                <box size="0.1 0.02 0.16" />
            </geometry>
            <material name="">
                <color rgba="1 1 1 0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.08" rpy="0 0 0" />
            <geometry>
                <box size="0.1 0.02 0.16" />
            </geometry>
        </collision>
    </link>
    <joint name="$(arg tf_prefix)forearm_shell-hand_shell" type="fixed">
      <origin xyz="0 0 0.3" rpy="0 0 ${pi}"/>
      <parent link="$(arg tf_prefix)forearm_shell"/>
      <child link="$(arg tf_prefix)hand_shell"/>
    </joint>
    <!-- Grasp Center -->
    <link name="$(arg tf_prefix)tcp" />
    <joint name="$(arg tf_prefix)tcp_joint" type="fixed">
        <origin xyz="0 0 0.3" rpy="0 0 ${pi}"/>
        <parent link="$(arg tf_prefix)forearm_shell"/>
        <child link="tcp"/>
    </joint>

</robot>
