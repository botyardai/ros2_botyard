<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="two_dexhand">
    <!-- 定义全局参数 -->
    <xacro:arg name="use_ros2_control" default="false" />
    <xacro:arg name="use_gazebo" default="false" />
    <xacro:arg name="use_mock_dexhand" default="false" />
    <xacro:arg name="dexhand_type" default="gs_s1" />
    <xacro:arg name="sub_version" default="original" />
    <xacro:arg name="dexhand_initial_positions_file" default="$(find dexhand_description)/config/initial_positions.yaml" />
    <xacro:arg name="dexhand_joint_limits_file" default="$(find dexhand_description)/config/$(arg dexhand_type)/joint_limits.yaml" />
    <xacro:arg name="dexhand_link_configs_file" default="$(find dexhand_description)/config/link_configs.yaml" />
    <!-- Import materials used in urdf -->
    <xacro:include filename="$(find dexhand_description)/urdf/inc/common.materials.xacro"/>

    <xacro:arg name="lh_prefix" default="lh_"/>
    <xacro:arg name="rh_prefix" default="rh_"/>
    <xacro:property name="prefix_list" value="${list(['$(arg lh_prefix)', '$(arg rh_prefix)'])}" />

<!-- construct pure URDF start -->
    <xacro:include filename="$(find dexhand_description)/urdf/dexhand_macro.xacro"/>
    <!-- create link fixed to the "world" -->
    <link name="world"/>
    <!-- left dexhand -->
    <xacro:dexhand_macro use_left_hand="true" prefix="$(arg lh_prefix)" parent_link="world" joint_type="fixed" dexhand_type="$(arg dexhand_type)" sub_version="$(arg sub_version)">
        <origin xyz="0.5 0 0" rpy="0 0 0" />  
    </xacro:dexhand_macro>
    <!-- right dexhand -->
    <xacro:dexhand_macro use_left_hand="false" prefix="$(arg rh_prefix)" parent_link="world" joint_type="fixed" dexhand_type="$(arg dexhand_type)" sub_version="$(arg sub_version)">
        <origin xyz="-0.5 0 0" rpy="0 0 0" />  
    </xacro:dexhand_macro>
<!-- construct pure URDF end -->

<!-- 2只手作为一个整体，所以<ros2_control>和<gazebo>要同时处理2只手的关节和连杆, 故prefix传入前缀的列表 -->
<!-- 注意: ros2_control的<hardware_interface>要实现对2只手的关节处理, 需要开发者定制实现 -->
    <!-- Import ros2_control description -->
    <xacro:if value="$(arg use_ros2_control)">
        <xacro:include filename="$(find dexhand_description)/config/dexhand.ros2_control.xacro"/>
        <!-- 注意这里需要为定制实现的hardware传入一个name -->
        <xacro:dexhand_ros2_control
            name="multi_dexhand_as_a_whole"
            use_gazebo="$(arg use_gazebo)"
            use_mock_dexhand="$(arg use_mock_dexhand)"
            initial_positions_file="$(arg dexhand_initial_positions_file)"
            joint_limits_file="$(arg dexhand_joint_limits_file)"
            prefix="${prefix_list}"
        />
    </xacro:if>

    <!-- Import gazebo description -->
    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="$(find dexhand_description)/config/dexhand.gazebo.xacro"/>
        <xacro:dexhand_gazebo_attribute
            link_configs_file="$(arg dexhand_link_configs_file)"
            joint_limits_file="$(arg dexhand_joint_limits_file)"
            prefix="${prefix_list}"
        />
        <xacro:dexhand_gazebo_plugin
            use_ros2_control="$(arg use_ros2_control)"
            joint_limits_file="$(arg dexhand_joint_limits_file)"
            prefix="${prefix_list}"
        />
    </xacro:if>
</robot>
