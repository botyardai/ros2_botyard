<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    GS-S1 sub-version 3 wrist adapter.
  -->
  <xacro:macro name="forearm_macro" params="use_left_hand prefix parent_link joint_type *origin">
    <xacro:property name="joint_vel" value="3.14"/>
    <xacro:property name="joint_acc" value="3.14"/>
    <xacro:property name="joint_effort" value="10"/>

    <joint name="${prefix}FOREARM" type="${joint_type}">
      <xacro:insert_block name="origin"/>
      <parent link="${parent_link}"/>
      <child link="${prefix}fabase"/>
    </joint>

    <!-- fabase -->
    <link name="${prefix}fabase">
      <inertial>
        <origin xyz="4.08824368899063E-05 0.0056433338281167 0.0858475106132551" rpy="0 0 0" />
        <mass value="0.134578343267534" />
        <inertia
          ixx="0.000274253196198939"
          ixy="6.41366437053646E-08"
          ixz="-3.06023342568536E-07"
          iyy="0.000387260323568856"
          iyz="-4.36736283600291E-06"
          izz="0.000182327882804633" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/fabase.STL" />
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/fabase.STL" />
        </geometry>
      </collision>
    </link>

    <!-- FAJ1 -->
    <link name="${prefix}falink1">
      <inertial>
        <origin xyz="4.92376891996426E-14 -1.52395457364563E-15 -3.96660730848375E-05" rpy="0 0 0" />
        <mass value="0.00434843190251012" />
        <inertia
          ixx="1.4497458938888E-07"
          ixy="-1.44644158647691E-23"
          ixz="-6.2078735236559E-22"
          iyy="3.72549511304545E-07"
          iyz="2.22943129394795E-11"
          izz="4.33303871896401E-07" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/falink1.STL" />
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/falink1.STL" />
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}FAJ1" type="revolute">
      <origin xyz="0 0.0024327 0.21" rpy="0 0 0" />
      <parent link="${prefix}fabase" />
      <child link="${prefix}falink1" />
      <axis xyz="-1 0 0" />
      <limit
        lower="${radians(-30.0)}"
        upper="${radians(50.0)}"
        effort="${joint_effort}"
        acceleration="${joint_acc}"
        velocity="${joint_vel}" />
    </joint>

    <!-- pmbase -->
    <link name="${prefix}pmbase">
      <inertial>
        <origin xyz="-0.00423889211015726 1.55146937927341E-07 0.0114344530148561" rpy="0 0 0" />
        <mass value="0.00678168302043476" />
        <inertia
          ixx="1.83974249616897E-06"
          ixy="1.31496090063303E-11"
          ixz="-1.242772088747E-07"
          iyy="1.1264384310047E-06"
          iyz="4.54092676689836E-12"
          izz="2.32951671141634E-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/pmbase.STL" />
        </geometry>
        <material name="grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://dexhand_description/meshes/gs_s1/sv_3/pmbase.STL" />
        </geometry>
      </collision>
    </link>
    <!-- palm_wrist_connector_joint -> FAJ3 -->
    <joint name="${prefix}FAJ3" type="revolute">
      <origin xyz="0 0 0" rpy="0 0 1.5708" />
      <parent link="${prefix}falink1" />
      <child link="${prefix}pmbase" />
      <xacro:if value="${use_left_hand}">
        <axis xyz="1 0 0" />
      </xacro:if>
      <xacro:unless value="${use_left_hand}">
        <axis xyz="-1 0 0" />
      </xacro:unless>
      <limit
        lower="${radians(-25.0)}"
        upper="${radians(25.0)}"
        effort="${joint_effort}"
        acceleration="${joint_acc}"
        velocity="${joint_vel}" />
    </joint>
  </xacro:macro>
</robot>
