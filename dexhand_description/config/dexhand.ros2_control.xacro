<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 手势 gpio 只在实现了 do_gesture 的硬件接口上注入：Humble 版硬件接口把所有 gpio 当作
         触觉区域处理，不导出 mode/gesture_id 命令接口，注入后 ResourceManager 会因找不到接口
         而让整个硬件激活失败。默认按发行版判断，可用 use_gesture_gpio:=true/false 显式覆盖。 -->
    <xacro:property name="ros_distro" value="$(optenv ROS_DISTRO jazzy)"/>
    <xacro:arg name="use_gesture_gpio" default="${ros_distro != 'humble'}"/>

    <xacro:macro name="command_state_interface" params="name joint_limit init_position ">
        <joint name="${name}">
            <xacro:if value="${joint_limit['has_velocity_limits']}">
            <command_interface name="position">
                <xacro:if value="${'min_position' in joint_limit}">
                    <param name="min">${joint_limit['min_position']}</param>
                </xacro:if>
                <xacro:if value="${'max_position' in joint_limit}">
                    <param name="max">${joint_limit['max_position']}</param>
                </xacro:if>
            </command_interface>
            <command_interface name="velocity">
                <xacro:if value="${'min_velocity' in joint_limit}">
                    <param name="min">${joint_limit['min_velocity']}</param>
                </xacro:if>
                <xacro:if value="${'max_velocity' in joint_limit}">
                    <param name="max">${joint_limit['max_velocity']}</param>
                </xacro:if>
            </command_interface>
            <command_interface name="effort"/>
            </xacro:if>

            <state_interface name="position">
                <param name="initial_value">${init_position}</param>
            </state_interface>
            <state_interface name="velocity">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="effort">
                <param name="initial_value">0.0</param>
            </state_interface>
        </joint>
    </xacro:macro>

    <xacro:macro name="loop_command_state_interface_with_prefix" params="items:=^ prefix:=''">
        <!-- https://robotics.stackexchange.com/questions/27111/creating-n-links-using-a-for-loop-in-xacro -->
        <xacro:if value="${items}">
            <!-- pop first item from list -->
            <xacro:property name="joint" value="${items.pop(0)}"/>
            <xacro:command_state_interface
                name="${prefix}${joint}"
                joint_limit="${joint_limits[joint]}"
                init_position="${initial_positions[joint]}"
            />
            <!-- recursively call myself -->
            <xacro:loop_command_state_interface_with_prefix items="${items}" prefix="${prefix}" />
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="loop_command_state_interface" params="items:=^ prefix:=^">
        <!-- https://robotics.stackexchange.com/questions/27111/creating-n-links-using-a-for-loop-in-xacro -->
        <!-- http://wiki.ros.org/xacro -->
        <xacro:if value="${prefix}">
            <!-- pop first item from list -->
            <xacro:property name="pre" value="${prefix.pop(0)}"/>
            <!-- list(items) let items untouched -->
            <xacro:loop_command_state_interface_with_prefix items="${list(items)}" prefix="${pre}" />
            <!-- recursively call myself -->
            <xacro:loop_command_state_interface/>
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="loop_tactile_interface_with_prefix" params="items:=^ prefix:=''">
        <xacro:if value="${items}">
            <!-- pop first item from list -->
            <xacro:property name="tact" value="${items.pop(0)}"/>
            <gpio name="${prefix}${tact}">
                <command_interface name="fz" data_type="double"/>
                <!-- 暂时只支持控制指尖的法向力 -->
                <state_interface name="fx" data_type="double"/>
                <state_interface name="fy" data_type="double"/>
                <state_interface name="fz" data_type="double"/>
            </gpio>
            <xacro:loop_tactile_interface_with_prefix items="${items}" prefix="${prefix}" />
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="loop_tactile_interface" params="items:=^ prefix:=^">
        <xacro:if value="${prefix}">
            <!-- pop first item from list -->
            <xacro:property name="pre" value="${prefix.pop(0)}"/>
            <!-- list(items) let items untouched -->
            <xacro:loop_tactile_interface_with_prefix items="${list(items)}" prefix="${pre}" />
            <!-- recursively call myself -->
            <xacro:loop_tactile_interface/>
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="loop_gesture_interface" params="prefix:=^">
        <xacro:if value="${prefix}">
            <xacro:property name="pre" value="${prefix.pop(0)}"/>
            <gpio name="${pre}do_gesture">
                <!-- ros2_control 4.29 仅支持 double/bool；接口值仍严格遵循 uint8 语义。 -->
                <command_interface name="mode" data_type="double">
                    <!-- 1 = TOPIC：上电即按 topic 命令控制，无 IDLE 中间态 -->
                    <param name="initial_value">1</param>
                </command_interface>
                <command_interface name="gesture_id" data_type="double">
                    <param name="initial_value">0</param>
                </command_interface>
                <state_interface name="result" data_type="double">
                    <param name="initial_value">0</param>
                </state_interface>
            </gpio>
            <xacro:loop_gesture_interface/>
        </xacro:if>
    </xacro:macro>

    <xacro:macro name="dexhand_ros2_control" params="name initial_positions_file joint_limits_file use_gazebo:=false use_mock_dexhand:=false
                                                     port_name:=/dev/dexhand communicate:=RS485 hand_id:=0 baudrate:=1000000 timeout_ms:=200 gesture_timeout_ms:=5000 debug:=false prefix:=${['']}">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>
        <xacro:property name="joint_limits" value="${xacro.load_yaml(joint_limits_file)['joint_limits']}"/>
        <xacro:property name="joint_names" value="${xacro.load_yaml(joint_limits_file)['joint_names']}"/>
        <!-- real <ros2_control> tag starts here -->
        <ros2_control name="${name}" type="system">
            <xacro:if value="${use_gazebo}">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:if>
            <xacro:if value="${use_mock_dexhand}">
                <hardware>
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">false</param>
                    <param name="mock_sensor_commands">false</param>
                    <!-- <param name="custom_interface_with_following_offset"></param> -->
                    <!-- <param name="disable_commands">false</param> -->
                    <!-- <param name="mock_gpio_commands">false</param> -->
                    <!-- <param name="position_state_following_offset">0.0</param> -->
                </hardware>
            </xacro:if>
            <xacro:unless value="${use_gazebo or use_mock_dexhand}">
                <xacro:property name="tmp_prefix_list" value="${list(prefix)}"/>
                <!-- 如果prefix列表里只有一个元素，那么就是需要给通用的hardware传递这个信息 -->
                <xacro:property name="joint_prefix" value="''"/>
                <xacro:property name="length" value="${len(prefix)}"/>
                <xacro:if value="${length == 1}">
                    <xacro:property name="joint_prefix" value="${prefix[0]}"/>
                </xacro:if>
                <hardware>
                    <!-- 连接真机通信 -->
                    <plugin>dexhand_hardware_interface/DexhandHardwareInterface</plugin>
                    <param name="joint_prefix">${joint_prefix}</param>
                    <param name="communicate">${communicate}</param>
                    <param name="port_name">${port_name}</param>
                    <param name="hand_id">${hand_id}</param>
                    <param name="baudrate">${baudrate}</param>
                    <param name="timeout_ms">${timeout_ms}</param>
                    <param name="gesture_timeout_ms">${gesture_timeout_ms}</param>
                    <!-- 调试开关：打开后 driver 输出详细日志，默认关闭 -->
                    <param name="debug">${debug}</param>
                    <!-- 设备身份 bridge topic：用相对名跟随 namespace 自动隔离（多手互不冲突），控制器按同名参数订阅 -->
                    <param name="hand_info_topic">hand_info</param>
                </hardware>
            </xacro:unless>
            <!-- joint -->
            <xacro:loop_command_state_interface items="${list(joint_names)}" prefix="${list(prefix)}"/>
            <!-- tactile sensors / ForceTorchSensor -->
            <xacro:property name="tactile_names" value="${['THT0', 'FFT0', 'MFT0', 'RFT0', 'LFT0']}"/>
            <xacro:loop_tactile_interface items="${list(tactile_names)}" prefix="${list(prefix)}"/>
            <!-- 手势 Action 使用的命令与结果接口。判断放在此处而非 loop_gesture_interface 内部：
                 xacro 在递归宏里求值 arg/property 会爆栈（maximum recursion depth exceeded）。 -->
            <xacro:if value="${xacro.arg('use_gesture_gpio')}">
                <xacro:loop_gesture_interface prefix="${list(prefix)}"/>
            </xacro:if>
        </ros2_control>
    </xacro:macro>
</robot>
