-->

    <!--添加joint名称-->
    <xacro:macro name="joint_name" params="name">
        <joint_name>${name}</joint_name>
    </xacro:macro>
    <xacro:macro name="loop_joint_name_with_prefix" params="items:=^ prefix:=''">
        <xacro:if value="${items}">
            <!-- pop first item from list -->
            <xacro:property name="joint" value="${items.pop(0)}"/>
            <xacro:joint_name name="${prefix}${joint}"/>
            <!-- recursively call myself -->
            <xacro:loop_joint_name_with_prefix items="${items}" prefix="${prefix}"/>
        </xacro:if>
    </xacro:macro>
    <xacro:macro name="loop_joint_name" params="items:=^ prefix:=^">
        <xacro:if value="${prefix}">
            <!-- pop first item from list -->
            <xacro:property name="pre" value="${prefix.pop(0)}"/>
            <xacro:loop_joint_name_with_prefix items="${list(items)}" prefix="${pre}"/>
            <!-- recursively call myself -->
            <xacro:loop_joint_name/>
        </xacro:if>
    </xacro:macro>


    <!--对外导出 dexhand_gazebo_attribute 宏-->
    <xacro:macro name="dexhand_gazebo_attribute" params="link_configs_file joint_limits_file prefix:=${['']}">
        <xacro:property name="link_names" value="${xacro.load_yaml(link_configs_file)['link_names']}"/>
        <xacro:property name="joint_names" value="${xacro.load_yaml(joint_limits_file)['joint_names']}"/>

        <!-- 不能放在 <gazebo>等tag内，必须跟URDF的<link> <joint>在同一层级 -->
        <xacro:loop_link_attribute items="${list(link_names)}" prefix="${list(prefix)}"/>
        <!-- xacro:loop_joint_transmission items="${list(joint_names)}"/ -->
    </xacro:macro>

    <!--对外导出 dexhand_gazebo_plugin 宏-->
    <xacro:macro name="dexhand_gazebo_plugin" params="use_ros2_control joint_limits_file prefix:=${['']}">
        <xacro:property name="joint_names" value="${xacro.load_yaml(joint_limits_file)['joint_names']}"/>
        <gazebo>
            <!-- 基础系统组件，初始化和管理所有在模型中定义的传感器 -->
            <plugin
                filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
                <render_engine>ogre2</render_engine>
            </plugin>
            <!-- Gazebo特有的传感器配置 -->
            <!-- http://sdformat.org/spec?ver=1.11&elem=sensor -->
            <plugin
                filename="gz-sim-forcetorque-system"
                name="gz::sim::systems::ForceTorque">
            </plugin>
            <plugin
                filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
            </plugin>
            <plugin
                filename="gz-sim-contact-system"
                name="gz::sim::systems::Contact">
            </plugin>

            <!-- 当gz通过/robot_description topic获取到模型，并spawn到它的world时会解析<gazebo>标签，加载plugin -->
            <xacro:if value="${use_ros2_control}">
                <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>$(find dexhand_description)/config/ros2_controllers.yaml</parameters>
                    <position_proportional_gain>0.1</position_proportional_gain>
                    <hold_joints>true</hold_joints>
                </plugin>
            </xacro:if>
            <!-- ros2_control有自己的joint_state_broadcaster来发布/joint_states topic
            如果不启用ros2_control，那么就得由这个gz-sim-joint-state-publisher-system来负责，
            并通过ros_gz_bridge来桥接，这样Rviz才能有动画显示 -->
            <xacro:unless value="${use_ros2_control}">
                <!-- https://gazebosim.org/docs/harmonic/migrating_gazebo_classic_ros2_packages/#modify-the-model -->
                <!-- 这个插件只有跟着joint的定义一起配置才不会报错 -->
                <!-- see Migration from Classic to Harmonic https://gazebosim.org/api/sim/8/migrationsdf.html -->
                <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
                    <topic>joint_states</topic>
                    <xacro:loop_joint_name items="${list(joint_names)}" prefix="${list(prefix)}"/>
                </plugin>

                <!-- 除了damping/friction, 也可增加弹簧刚度 <spring_stiffness>100.0</spring_stiffness> -->
                <!-- 当然基于PID控制器去维持关节位置也行 -->
                <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
                    <topic>joint_position_cmd</topic>
                    <p_gain>1.0</p_gain>
                    <i_gain>0.1</i_gain>
                    <d_gain>0.01</d_gain>
                    <joint_name>FFJ3</joint_name> <!--该控制器只能控制单个joint-->
                </plugin>
            </xacro:unless>
        </gazebo>
    </xacro:macro>
</robot>
