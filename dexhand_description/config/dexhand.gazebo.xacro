<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--添加link属性宏-->
    <xacro:macro name="link_attribute" params="name color">
        <gazebo reference="${name}">
            <material>Gazebo/${color}</material>
            <!-- 还需调校相关参数才能接近真正意义上的仿真-->
            <gravity>false</gravity>
            <selfCollide>false</selfCollide>
            <mu1 value="0.5"/>
            <mu2 value="0.5"/>
            <kp value="1000000.0"/>
            <kd value="1.0"/>
            <fdir1 value="1 0 0"/>
        </gazebo>
    </xacro:macro>
    <xacro:macro name="loop_link_attribute_with_prefix" params="items:=^ prefix:=''">
        <xacro:if value="${items}">
            <!-- pop first item from list -->
            <xacro:property name="link" value="${items.pop(0)}"/>
            <xacro:link_attribute name="${prefix}${link}" color="Grey"/>
            <!-- recursively call myself -->
            <xacro:loop_link_attribute_with_prefix items="${items}" prefix="${prefix}"/>
        </xacro:if>
    </xacro:macro>
    <xacro:macro name="loop_link_attribute" params="items:=^ prefix:=^">
        <xacro:if value="${prefix}">
            <!-- pop first item from list -->
            <xacro:property name="pre" value="${prefix.pop(0)}"/>
            <xacro:loop_link_attribute_with_prefix items="${list(items)}" prefix="${pre}"/>
            <!-- recursively call myself -->
            <xacro:loop_link_attribute/>
        </xacro:if>
    </xacro:macro>

    <!--添加joint驱动器-->
